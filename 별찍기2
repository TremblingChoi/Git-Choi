for i in range(a):
    if i < (a//2):
        for x in range(a-i):
            print(" ", end="")
        for x in range(i*2+1):
            print("*", end="")
    else:
        for x in range(a - i):
            print(" ", end="")
        for x in range(i*2+1 - a):
            print("*", end="")
        for x in range(a - (i*2+1 - a)):
            print(" ", end="")
        for x in range(i*2+1 - a):
            print("*", end="")
    print()

for i in range(a):
    if i <= (a // 2):
        print(" " * (a // 2 - i), end="")
        print("*" * (2 * i + 1))
    else:
        print(" " * (i - a//2), end="")
        print("*" * (a - (2*i - a) - 1))
