def is_leap_year(y) :
    if (y % 4 == 0 and y % 100 != 0) or (y % 400 == 0) :
        return True
    else :
        return False

def month_days(y,m) :
    if m == {1,3,5,7,9,11} :
        return 31
    elif m == {4,6,8,10,12} :
        return 30
    elif m==2 :
        return 29 if is_leap_year(y) else 28

y=int(input('연도? '))
m=int(input('월? '))
d=month_days(y,m)
print(f'{y}년 {m}월은 {d}일까지 있습니다')
